# ---------------------------------------------------------------
# Dependencies (libraries never commit composer.lock)
# ---------------------------------------------------------------
/vendor/
/node_modules/
composer.lock
composer.phar

# Keep package-lock.json committed: CI uses `npm ci` for reproducible dist/ builds.

# ---------------------------------------------------------------
# Build, test & tool caches
# ---------------------------------------------------------------
/build/
/coverage/
/.phpunit.cache/
.phpunit.result.cache
/.php-cs-fixer.cache
/.php-cs-fixer.php
/.pint.cache
/phpstan.neon
/phpunit.xml
/.phpstan/
/workbench/
/testbench.yaml
*.tsbuildinfo
/.vitest/
/.eslintcache
/.cache/
/tmp/

# ---------------------------------------------------------------
# Logs & local data
# ---------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.sqlite
*.sqlite-journal
*.csv

# ---------------------------------------------------------------
# Environment & secrets
# ---------------------------------------------------------------
.env
.env.*
!.env.example
auth.json
*.pem
*.key

# ---------------------------------------------------------------
# Editors & IDEs
# ---------------------------------------------------------------
/.idea/
/.vscode/
/.fleet/
/.zed/
/.nova/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ---------------------------------------------------------------
# AI assistants (local settings only; CLAUDE.md stays committed)
# ---------------------------------------------------------------
/.claude/settings.local.json
/.cursor/
/.aider*
/.continue/

# ---------------------------------------------------------------
# OS files
# ---------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.directory
.Trash-*
