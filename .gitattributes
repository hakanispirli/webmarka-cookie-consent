* text=auto eol=lf
*.png binary

# Composer installs only what the package needs at runtime:
# src, config, routes, database, lang, resources/views, dist, README, LICENSE, llms.txt.
# Sources, tests and tooling are excluded, so no Node.js is needed on servers.
/.github              export-ignore
/docs                 export-ignore
/tests                export-ignore
/tests-js             export-ignore
/scripts              export-ignore
/resources/js         export-ignore
/resources/css        export-ignore
/.editorconfig        export-ignore
/.gitattributes       export-ignore
/.gitignore           export-ignore
/phpunit.xml.dist     export-ignore
/phpstan.neon.dist    export-ignore
/pint.json            export-ignore
/tsconfig.json        export-ignore
/vitest.config.ts     export-ignore
/package.json         export-ignore
/package-lock.json    export-ignore
/CLAUDE.md            export-ignore
/CONTRIBUTING.md      export-ignore
/CODE_OF_CONDUCT.md   export-ignore
/SECURITY.md          export-ignore

# Generated files: collapse in diffs, exclude from language stats.
/dist/**              linguist-generated -diff
